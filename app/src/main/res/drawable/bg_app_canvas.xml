<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Canvas Solid Background -->
    <item>
        <color android:color="@color/canvas_bg"/>
    </item>

    <!-- Subtle Ambient Top Glow for visual depth -->
    <item>
        <shape>
            <gradient
                android:startColor="@color/brand_primary_glow"
                android:endColor="@android:color/transparent"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Fashionable Tech Dot Matrix Pattern Tile -->
    <item>
        <bitmap
            android:src="@drawable/bg_pattern_tile"
            android:tileMode="repeat"
            android:dither="true"
            android:gravity="top|start"/>
    </item>
</layer-list>
