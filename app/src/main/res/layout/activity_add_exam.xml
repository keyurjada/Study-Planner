<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔙 Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/color_000" />

        <TextView
            android:layout_centerInParent="true"
            android:text="@string/str_add_exam"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <!-- 📦 Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_modern"
        android:elevation="6dp">

        <EditText
            android:id="@+id/examName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Exam Name"
            android:padding="12dp"
            android:background="@drawable/bg_input_modern"/>

        <EditText
            android:id="@+id/examSubject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Subject"
            android:padding="12dp"
            android:background="@drawable/bg_input_modern"/>

        <EditText
            android:id="@+id/examDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:hint="Select Date"
            android:padding="12dp"
            android:background="@drawable/bg_input_modern"/>

        <!-- 🎯 Priority -->
        <TextView
            android:text="@string/str_priority"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textColor="@color/color_333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <RadioGroup
            android:id="@+id/priorityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioImportant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_important"
                android:textStyle="bold"
                android:textColor="@color/color_d32f2f"
                android:buttonTint="@color/color_d32f2f"
                android:layout_marginEnd="20dp"/>

            <RadioButton
                android:id="@+id/radioNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_normal"
                android:textStyle="bold"
                android:textColor="@color/color_f57c00"
                android:buttonTint="@color/color_f57c00"/>
        </RadioGroup>

        <!-- 🚀 Button -->
        <Button
            android:id="@+id/btnAddExam"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="@string/str_save_exam"
            android:textColor="@color/color_fff"
            android:textStyle="bold"
            android:background="@drawable/bg_button"/>
    </LinearLayout>

</LinearLayout>