<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app_canvas">

    <!-- Success Icon Container -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/brand_emerald_light"
        android:layout_marginBottom="28dp">

        <ImageView
            android:id="@+id/successIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_email"
            app:tint="@color/brand_emerald"
            android:contentDescription="Reset Email Sent Icon" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_reset_link_sent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="-0.01"/>

    <!-- Description -->
    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_reset_link_instructions"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.25"
        android:layout_marginTop="10dp"/>

    <!-- Action Button -->
    <Button
        android:id="@+id/goHomeBtn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/str_back_to_login"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:background="@drawable/bg_fab_gradient"
        android:layout_marginTop="40dp"/>

</LinearLayout>