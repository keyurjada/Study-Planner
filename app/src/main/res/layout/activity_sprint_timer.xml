<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/btnCloseTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/surface_card"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Close Focus Session"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/txtTimerSubjectBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_chip_subject"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Operating Systems"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Mission Header -->
    <TextView
        android:id="@+id/txtTimerMissionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Solve 5 Dynamic Programming Problems"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/txtTimerMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎯 Problem Solving • 🧠 Deep Grind"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 2-Minute Kickstart Spotlight Card -->
    <LinearLayout
        android:id="@+id/cardKickstartSpotlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_kickstart_box"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="IMMEDIATE 2-MINUTE KICKSTART:"
                android:textColor="@color/brand_emerald_dark"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTimerKickstartText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Read question #1 and copy given values onto scratchpad"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Focus only on finishing this tiny action to overcome resistance."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Timer Countdown Section -->
    <RelativeLayout
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_marginTop="28dp">

        <ProgressBar
            android:id="@+id/progressCircularTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/circle_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTimerDigits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25:00"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/txtTimerStateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⚡ SPRINT IN PROGRESS"
                android:textColor="@color/brand_emerald"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCompleteSprint"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_fab_gradient"
            android:elevation="4dp"
            android:text="🎉 Complete Mission (+XP)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPauseResume"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet_button"
                android:text="⏸️ Pause"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuitSprint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet_button"
                android:text="⏹️ Cancel"
                android:textColor="@color/brand_coral"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
